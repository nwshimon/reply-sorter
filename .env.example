# Copy to .env.local (or run `vercel env pull .env.local`). Never commit real values.

# Neon Postgres (added automatically by the Vercel Marketplace integration)
# Pooled connection, used by the app
DATABASE_URL=
# Direct connection, used by drizzle-kit
DATABASE_URL_UNPOOLED=

# Model provider: one OpenAI-compatible client, chosen by these three variables (Cerebras today).
# Changing provider means changing these, not code.
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_API_KEY=
CLASSIFIER_MODEL=gpt-oss-120b

# Optional backup provider, only used if the main one fails (not wired up yet)
BACKUP_LLM_BASE_URL=
BACKUP_LLM_API_KEY=
BACKUP_MODEL=

# v1 = results from the v0 policy (the baseline); v2 = the v1 policy; v3 = the v1 policy with automated receipts as out_of_office. Bump on any prompt or schema change, and only then.
PROMPT_VERSION=v3
