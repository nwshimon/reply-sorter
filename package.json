{
  "name": "reply-sorter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "classify": "tsx --env-file=.env.local scripts/classify-all.ts",
    "classify:heldout": "tsx --env-file=.env.local scripts/classify-all.ts --heldout",
    "reapply": "tsx --env-file=.env.local scripts/reapply-policy.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
